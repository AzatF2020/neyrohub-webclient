---
import FaqAccordion from '../components/FaqAccordion.vue';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import {
	creditsLabel,
	fetchTariffs,
	formatCredits,
	formatPrice,
	freeTariff,
	paidTariffs,
	splitTariffs,
} from '../lib/tariffs';

// Прайс приезжает с бэкенда на сервере: цены видны поисковикам и не мигают при загрузке.
// Кешировать нечего — тарифы меняются в базе, и страница должна показывать текущие.
const user = Astro.locals.user;
const tariffs = await fetchTariffs();

const packages = paidTariffs(tariffs);
const free = freeTariff(tariffs);

// Два пакета крупными карточками, остальные — компактной строкой под ними
const { featured, rest } = splitTariffs(packages);
const cta = user ? 'Перейти в кабинет' : 'Начать';
const ctaHref = user ? '/app' : '/register';

const included = [
	{
		title: 'Все модели сразу',
		text: 'Кредиты общие: картинки, видео и переписка с текстовой моделью тратят один счёт. Отдельной платы за «премиум-модель» нет.',
	},
	{
		title: 'Платите за результат',
		text: 'Если генерация не удалась, кредиты возвращаются на счёт полностью — за неудачную задачу с вас не спишут ничего.',
	},
	{
		title: 'Ничего не пропадает',
		text: 'Запросы и результаты остаются в чатах кабинета: вернуться к прошлой работе, повторить или доработать можно в любой момент.',
	},
];

const faq = [
	{
		question: 'Что такое кредит?',
		answer:
			'Внутренняя валюта сервиса. Цена генерации зависит от модели и настроек: картинка в 1K дешевле, чем в 4K, ролик считается по секундам, а ответ в чате — по объёму текста.',
	},
	{
		question: 'Это подписка?',
		answer:
			'Нет. Пакет покупается разово, автосписаний нет. Закончились кредиты — берёте следующий пакет, когда посчитаете нужным.',
	},
	{
		question: 'Кредиты сгорают?',
		answer:
			'Купленные — нет, они ждут вас на счёте. Стартовые начисляются после подтверждения почты и живут ограниченное время: это проба, а не запас.',
	},
	{
		question: 'С какого пакета начать?',
		answer:
			'С меньшего. Он покажет, сколько кредитов уходит на ваши задачи, а докупить следующий можно в любой момент — переносить ничего не придётся.',
	},
];
---

<Layout
	title="Тарифы — NeyroHub"
	description="Пакеты кредитов NeyroHub: разовая оплата без подписки, один счёт на изображения, видео и чат"
>
	<Header />

	<main>
		<section class="relative overflow-hidden">
			<div class="glow pointer-events-none absolute inset-x-0 top-0 h-[28rem]" aria-hidden="true">
			</div>

			<div class="relative mx-auto w-full max-w-5xl px-4 pt-16 pb-12 sm:pt-24">
				<span
					class="inline-flex items-center rounded-full border border-border px-3 py-1 text-xs text-muted-foreground"
				>
					Разовая оплата, без подписки
				</span>

				<h1
					class="mt-6 max-w-2xl text-4xl font-semibold tracking-tight text-balance sm:text-5xl sm:leading-[1.1]"
				>
					Покупаете кредиты — тратите как удобно
				</h1>

				<p class="mt-5 max-w-xl text-lg text-muted-foreground">
					Один счёт на изображения, видео и переписку с моделью. Чем больше пакет, тем дешевле
					обходится кредит.
				</p>

				{
					free && (
						<p class="mt-6 inline-flex flex-wrap items-center gap-x-2 gap-y-1 rounded-lg border border-border bg-card px-4 py-3 text-sm">
							<span class="font-medium">
								{formatCredits(free.credits)} {creditsLabel(free.credits)} бесплатно
							</span>
							<span class="text-muted-foreground">{free.description}</span>
						</p>
					)
				}
			</div>
		</section>

		<section class="mx-auto w-full max-w-5xl px-4 pb-20">
			{
				packages.length === 0 ? (
					<p class="rounded-xl border border-border bg-card p-5 text-sm text-muted-foreground">
						Прайс сейчас недоступен. Обновите страницу через минуту — тарифы вернутся.
					</p>
				) : (
					<div class="grid gap-4">
						<div class="grid gap-4 sm:grid-cols-2">
							{featured.map((tariff, index) => {
								const isPrimary = index === 0;

								return (
									<article
										class:list={[
											'flex flex-col rounded-2xl border bg-card p-6 sm:p-7',
											isPrimary ? 'border-primary/50 ring-1 ring-primary/20' : 'border-border',
										]}
									>
										{/* Строка-метка есть только у рекомендованного, но место под неё держат оба: иначе карточки разъедутся */}
										<p class="flex h-5 items-center gap-1.5 text-xs font-medium text-primary">
											{isPrimary && (
												<>
													<svg
														xmlns="http://www.w3.org/2000/svg"
														viewBox="0 0 24 24"
														fill="currentColor"
														class="size-3.5"
														aria-hidden="true"
													>
														<path d="m12 2.5 2.9 6.06 6.6.9-4.8 4.62 1.18 6.52L12 17.5l-5.88 3.1L7.3 14.08 2.5 9.46l6.6-.9z" />
													</svg>
													Выбирают чаще
												</>
											)}
										</p>

										<h2 class="mt-3 text-lg font-medium">{tariff.title ?? tariff.slug}</h2>

										<p class="mt-4 text-4xl font-semibold tracking-tight">
											{formatPrice(tariff.price)}
										</p>
										<p class="mt-1.5 text-sm text-primary">
											{formatCredits(tariff.credits)} {creditsLabel(tariff.credits)}
										</p>

										<p class="mt-5 flex-1 text-sm text-muted-foreground">{tariff.description}</p>

										<a
											href={ctaHref}
											class:list={[
												'mt-7 inline-flex h-11 items-center justify-center rounded-md px-5 text-sm font-medium',
												isPrimary
													? 'bg-primary text-primary-foreground transition-opacity hover:opacity-90'
													: 'border border-border transition-colors hover:bg-muted',
											]}
										>
											{cta}
										</a>
									</article>
								);
							})}
						</div>

						{/* Остальные пакеты: одна полоса с волосяными разделителями — gap-px на фоне цвета рамки */}
						<div class="grid gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-3">
							{rest.map((tariff) => (
								<a
									href={ctaHref}
									class="flex items-center justify-between gap-3 bg-card px-5 py-4 transition-colors hover:bg-muted/60"
								>
									<span class="min-w-0">
										<span class="block truncate text-sm font-bold">
											{tariff.title ?? tariff.slug}
										</span>
										<span class="block text-xs text-muted-foreground">
											{formatCredits(tariff.credits)} {creditsLabel(tariff.credits)}
										</span>
									</span>
									<span class="text-sm font-medium whitespace-nowrap">
										{formatPrice(tariff.price)}
									</span>
								</a>
							))}
						</div>
					</div>
				)
			}

			<p class="mt-4 text-xs text-muted-foreground">
				Цены указаны в рублях. Оплата разовая: кредиты зачисляются на счёт сразу после платежа.
			</p>
		</section>

		<section class="border-t border-border/60">
			<div class="mx-auto w-full max-w-5xl px-4 py-16">
				<h2 class="text-sm font-medium tracking-wide text-muted-foreground uppercase">
					Входит в любой пакет
				</h2>

				<div class="mt-8 grid gap-8 sm:grid-cols-3">
					{
						included.map((item) => (
							<article>
								<h3 class="text-[15px] font-medium">{item.title}</h3>
								<p class="mt-1.5 text-sm text-muted-foreground">{item.text}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="border-t border-border/60">
			<div class="mx-auto w-full max-w-5xl px-4 py-16">
				<h2 class="text-sm font-medium tracking-wide text-muted-foreground uppercase">
					Частые вопросы
				</h2>

				<!-- Остальная страница статична, поэтому островок гидратируется только при прокрутке до него -->
				<FaqAccordion client:visible items={faq} class="mt-8" />
			</div>
		</section>

		<section class="border-t border-border/60">
			<div
				class="mx-auto flex w-full max-w-5xl flex-wrap items-center justify-between gap-6 px-4 py-16"
			>
				<div class="max-w-md">
					<h2 class="text-2xl font-semibold tracking-tight text-balance">
						Начните с бесплатных кредитов
					</h2>
					<p class="mt-2 text-sm text-muted-foreground">
						Регистрация занимает минуту, пакет можно выбрать позже — когда станет понятно, сколько
						генераций вам нужно.
					</p>
				</div>

				<a
					href={ctaHref}
					class="inline-flex h-10 items-center rounded-md bg-primary px-5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
				>
					{user ? 'Перейти в кабинет' : 'Начать бесплатно'}
				</a>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
