# Origin бэкенда с better-auth (сервер Astro ходит туда напрямую)
AUTH_ORIGIN=http://localhost:8080
AUTH_BASE_PATH=/api/auth

# Оставьте пустым, чтобы браузер работал через прокси Astro (/api/auth/*) — один origin, без CORS.
# Заполните (http://localhost:8080/api/auth), если хотите, чтобы браузер ходил на бэкенд напрямую.
PUBLIC_AUTH_BASE_URL=

# База для прикладного API (axios-клиент в src/lib/api.js)
PUBLIC_API_BASE_URL=/api

# Прикладное API бэкенда: сервер Astro проксирует туда /api/* (кроме /api/auth/*)
API_ORIGIN=http://localhost:8080

# Socket.IO бэкенда. Браузер подключается напрямую — gateway отдаёт CORS *
PUBLIC_SOCKET_URL=http://localhost:8080
